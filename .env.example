    # Qura Client Portal backend — example environment.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# All variables use the QURA_ prefix and are Qura-owned (never Arham's).

# --- Runtime ---------------------------------------------------------------
QURA_ENVIRONMENT=development          # development | test | staging | production
QURA_APP_NAME=Qura Client Portal API
QURA_API_PREFIX=/api/client
QURA_HOST=0.0.0.0
QURA_PORT=8787

# --- Database --------------------------------------------------------------
# Qura's OWN PostgreSQL. Must use the async driver AND name a database whose
# name starts with the prefix below (the guard refuses anything else and never
# falls back to another project's database). Leave unset to run health-only.
# Use a dedicated, disposable database for development.
# QURA_DATABASE_URL=postgresql+asyncpg://qura:password@localhost:55432/qura_client
QURA_DATABASE_NAME_PREFIX=qura_
QURA_DATABASE_ECHO=false
QURA_DATABASE_POOL_SIZE=5
QURA_DATABASE_MAX_OVERFLOW=10
QURA_DATABASE_POOL_TIMEOUT_SECONDS=30

# --- Security --------------------------------------------------------------
# Required to be strong (>=32 chars, not a known default) outside development.
# Signs the opaque session cookie (HMAC). Rotating it invalidates all sessions.
QURA_SESSION_SECRET=qura-dev-secret-change-me
QURA_SESSION_COOKIE_NAME=qura_client_session
QURA_CSRF_COOKIE_NAME=qura_client_csrf
# Session lifetime / cookie max-age (seconds). Default 7 days.
QURA_SESSION_MAX_AGE_SECONDS=604800
# Password-reset token time-to-live (seconds). Default 30 minutes.
QURA_PASSWORD_RESET_TTL_SECONDS=1800

# --- CORS ------------------------------------------------------------------
# Comma-separated explicit origins. Empty disables CORS middleware.
# Same-origin API routing is planned, so this may stay empty in that model.
QURA_CORS_ALLOW_ORIGINS=
QURA_CORS_ALLOW_CREDENTIALS=true

# --- Logging ---------------------------------------------------------------
QURA_LOG_LEVEL=INFO
QURA_LOG_JSON=true

# --- Document storage (private) --------------------------------------------
# Private filesystem root for uploaded policy/claim documents. Files here are
# NEVER served publicly; downloads stream through an authenticated, ownership-
# checked endpoint. Use an absolute path in production and back it up/secure it
# like any other data store.
QURA_STORAGE_DIR=var/storage
# Maximum size of a single uploaded document, in bytes. Default 15 MB.
QURA_UPLOAD_MAX_BYTES=15728640

# --- AI policy extraction (OpenAI-compatible, OPTIONAL) --------------------
# Used by POST /policies/extract and the extraction step of POST /policies/upload.
# Leave QURA_OPENAI_API_KEY empty to run WITHOUT extraction: the endpoints then
# report extraction as unavailable and never fabricate field values. Upload
# still persists the fields the user supplies.
QURA_OPENAI_API_KEY=
QURA_OPENAI_API_BASE=https://api.openai.com/v1
QURA_OPENAI_MODEL_NAME=gpt-4.1
QURA_OPENAI_TIMEOUT_SECONDS=60
